      {
        "sym": "\\(Q\\)",
        "def": "Reaction Q-value [MeV]"
      }
    ],
    "description": [
      {
        "p": "An Expression for kinematic threshold energy for endoergic nuclear reaction. Reaction energy is provided by initial kinetic energy."
      }
    ]
  },
  {
    "id": "prc-27",
    "column": "left",
    "title": "Equation 27: Coulombic Barrier Threshold Energy",
    "equations": [
      "\\[E_{1}^{C} \\approx 1.2\\;\\frac{Z_1 Z_2}{A_{1}^{1/3} + A_2^{1/3}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(E_{1}^{C}\\)",
        "def": "Coulombic barrier energy [MeV]"
      },
      {
        "sym": "\\(Z_1,Z_2\\)",
        "def": "Atomic numbers of reactant nuclei [-]"
      },
      {
        "sym": "\\(A_1,A_2\\)",
        "def": "Mass numbers of reactant nuclei [-]"
      }
    ],
    "description": [
      {
        "p": "Estimate of Coulombic barrier between two nuclei — energy needed to overcome electrostatic repulsion for fusion or reaction."
      }
    ]
  },
  {
    "id": "prc-28",
    "column": "left",
    "title": "Equation 28: Excitation Energy",
    "equations": [
