[
  {
    "id": "prc-1",
    "column": "left",
    "title": "Equation 1: Elemental Atomic Mass by Abundance",
    "equations": [
      "\\[A_x = \\sum_i \\gamma_i A_i\\]"
    ],
    "variables": [
      {
        "sym": "\\(A_x\\)",
        "def": "Atomic mass of element x [g/mol or amu]"
      },
      {
        "sym": "\\(\\gamma_i\\)",
        "def": "Isotopic abundance of isotope i [-]"
      },
      {
        "sym": "\\(A_i\\)",
        "def": "Atomic mass of isotope i [g/mol or amu]"
      }
    ],
    "description": [
      {
        "p": "Atomic mass of an element calculated as the sum of isotopic atomic masses weighted by their isotopic abundances."
      }
    ]
  },
  {
    "id": "prc-2",
    "column": "left",
    "title": "Equation 2: Weight Fraction Calculation",
    "equations": [
      "\\[w_x = \\frac{n A_x}{n A_x + m A_y}\\]"
    ],
    "variables": [
      {
        "sym": "\\(w_x\\)",
        "def": "Weight fraction of element x [-]"
      },
      {
        "sym": "\\(n\\)",
        "def": "Number of x atoms in compound [-]"
      },
      {
        "sym": "\\(A_x\\)",
        "def": "Atomic mass of element x [g/mol or amu]"
      },
      {
        "sym": "\\(m\\)",
        "def": "Number of y atoms in compound [-]"
      },
      {
        "sym": "\\(A_y\\)",
        "def": "Atomic mass of element y [g/mol or amu]"
      }
    ],
    "description": [
      {
        "p": "Weight fraction of element x in a two-component compound."
      }
    ]
  },
  {
    "id": "prc-3",
    "column": "middle",
    "title": "Equation 3: Elemental Atomic Mass by Weight Fraction",
    "equations": [
      "\\[A_x = \\Bigl[\\sum_i \\frac{w_i}{A_i}\\Bigr]^{-1}\\]"
    ],
    "variables": [
      {
        "sym": "\\(A_x\\)",
        "def": "Atomic mass of element x [g/mol or amu]"
      },
      {
        "sym": "\\(w_i\\)",
        "def": "Weight fraction of isotope i [-]"
      },
      {
        "sym": "\\(A_i\\)",
        "def": "Atomic mass of isotope i [g/mol or amu]"
      }
    ],
    "description": [
      {
        "p": "Atomic mass of element calculated by weight fraction of each isotope."
      }
    ]
  },
  {
    "id": "prc-4",
    "column": "left",
    "title": "Equation 4: Number Density using Number Fraction",
    "equations": [
      "\\[N_i = \\frac{\\gamma_i \\rho_x N_A}{A_x}\\]"
    ],
    "variables": [
      {
        "sym": "\\(N_i\\)",
        "def": "Number density of isotope i [#/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\gamma_i\\)",
        "def": "Abundance (or number fraction) of isotope i [-]"
      },
      {
        "sym": "\\(\\rho_x\\)",
        "def": "Elemental mass density [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(N_A\\)",
        "def": "Avogadro&#x27;s number [#/mol]"
      },
      {
        "sym": "\\(A_x\\)",
        "def": "Atomic mass of element x [g/mol]"
      }
    ],
    "description": [
      {
        "p": "Number density (particles per unit volume) for isotope i calcuated using number fraction or abundance."
      }
    ]
  },
  {
    "id": "prc-5",
    "column": "left",
    "title": "Equation 5: Mass Density of Element x",
    "equations": [
      "\\[\\rho_x = w_x \\rho\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\rho_x\\)",
        "def": "Density of element x [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(w_x\\)",
        "def": "Weight fraction of element x [-]"
      },
      {
        "sym": "\\(\\rho\\)",
        "def": "Compound density [g/cm<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "Element density expressed as the mass fraction of a component times the compound density."
      }
    ]
  },
  {
    "id": "prc-6",
    "column": "middle",
    "title": "Equation 6: Number Density from Weight Fraction",
    "equations": [
      "\\[N_i = \\frac{w_i \\rho_x N_A}{A_i}\\]"
    ],
    "variables": [
      {
        "sym": "\\(N_i\\)",
        "def": "Number density of isotope i [#/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(w_i\\)",
        "def": "Weight fraction of isotope i [-]"
      },
      {
        "sym": "\\(\\rho_x\\)",
        "def": "Mass density of element x [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(N_A\\)",
        "def": "Avogadro&#x27;s number [#/mol]"
      },
      {
        "sym": "\\(A_i\\)",
        "def": "Atomic mass of isotope i [g/mol]"
      }
    ],
    "description": [
      {
        "p": "Number density for isotope i calculated using weight fraction"
      }
    ]
  },
  {
    "id": "prc-7",
    "column": "middle",
    "title": "Equation 7: Kinetic Energy (relativistic form)",
    "equations": [
      "\\[T = mc^2 - m_0 c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(T\\)",
        "def": "Kinetic energy [MeV]"
      },
      {
        "sym": "\\(m\\)",
        "def": "Relativistic mass [amu]"
      },
      {
        "sym": "\\(m_0\\)",
        "def": "Rest mass [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Relativistic kinetic energy expressed as a mass difference between relativistic mass and rest mass."
      }
    ]
  },
  {
    "id": "prc-8",
    "column": "right",
    "title": "Equation 8: Rest Mass Energy",
    "equations": [
      "\\[E_0 = m_0 c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(E_0\\)",
        "def": "Rest mass energy [MeV]"
      },
      {
        "sym": "\\(m_0\\)",
        "def": "Rest mass [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Einstein&#x27;s mass–energy relation giving the rest energy associated with a particle&#x27;s rest mass."
      }
    ]
  },
  {
    "id": "prc-9",
    "column": "right",
    "title": "Equation 9: Relativistic Mass",
    "equations": [
      "\\[m = \\frac{m_0}{\\sqrt{1-(v/c)^2}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(m\\)",
        "def": "Relativistic mass [amu]"
      },
      {
        "sym": "\\(m_0\\)",
        "def": "Rest mass [amu]"
      },
      {
        "sym": "\\(v\\)",
        "def": "Particle speed [m/s]"
      },
      {
        "sym": "\\(c\\)",
        "def": "Speed of light, 2.99792458 &times; 10<sup>8</sup> [m/s]"
      }
    ],
    "description": [
      {
        "p": "Expression for relativistic mass as a function of velocity; used in special relativity to relate moving and rest mass."
      }
    ]
  },
  {
    "id": "prc-10",
    "column": "middle",
    "title": "Equation 10: De Broglie Wavelength",
    "equations": [
      "\\[\\lambda = \\frac{h}{p}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\lambda\\)",
        "def": "Wavelength [m]"
      },
      {
        "sym": "\\(h\\)",
        "def": "Planck&#x27;s constant, 6.626 &times; 10<sup>-34</sup> [J-s]"
      },
      {
        "sym": "\\(p\\)",
        "def": "Momentum [kg·m/s]"
      }
    ],
    "description": [
      {
        "p": "The de Broglie relation linking a particle&#x27;s wavelength to its momentum."
      }
    ]
  },
  {
    "id": "prc-11",
    "column": "right",
    "title": "Equation 11: Photon Energy",
    "equations": [
      "\\[E = h \\nu\\]"
    ],
    "variables": [
      {
        "sym": "\\(E\\)",
        "def": "Energy of photon [J]"
      },
      {
        "sym": "\\(h\\)",
        "def": "Planck&#x27;s constant, 6.626 &times; 10<sup>-34</sup> [J-s]"
      },
      {
        "sym": "\\(\\nu\\)",
        "def": "Frequency [Hz]"
      }
    ],
    "description": [
      {
        "p": "Planck&#x27;s relation giving the energy of a photon in terms of its frequency."
      }
    ]
  },
  {
    "id": "prc-12",
    "column": "right",
    "title": "Equation 12: Photon Momentum",
    "equations": [
      "\\[p = \\frac{E}{c}\\]"
    ],
    "variables": [
      {
        "sym": "\\(p\\)",
        "def": "Momentum [kg-m/s]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Energy of photon [J]"
      },
      {
        "sym": "\\(c\\)",
        "def": "Speed of light, 2.99792458 &times; 10<sup>8</sup> [m/s]"
      }
    ],
    "description": [
      {
        "p": "Relationship between momentum and energy for a photon. Only applicable for photons."
      }
    ]
  },
  {
    "id": "prc-13",
    "column": "left",
    "title": "Equation 13: Semi-empirical Mass (Weizsäcker) Formula",
    "equations": [
      "\\[E_B = a_v A - a_s A^{2/3} - a_c \\frac{Z^2}{A^{1/3}} - a_a \\frac{(A-2Z)^2}{A} \\pm a_p A^{-1/2}\\]"
    ],
    "variables": [
      {
        "sym": "\\(E_B\\)",
        "def": "Binding energy [MeV]"
      },
      {
        "sym": "\\(a_v,a_s,a_c,a_a,a_p\\)",
        "def": "Weizsäcker coefficients (volume, surface, coulomb, asymmetry, parity)"
      },
      {
        "sym": "\\(A\\)",
        "def": "Atomic mass number [-]"
      },
      {
        "sym": "\\(Z\\)",
        "def": "Atomic number [-]"
      }
    ],
    "description": [
      {
        "p": "Semi-empirical formula estimating nuclear binding energy using five terms: volume, surface, Coulomb, asymmetry, and parity."
      }
    ]
  },
  {
    "id": "prc-14",
    "column": "left",
    "title": "Equation 14: Binding Energy from Masses",
    "equations": [
      "\\[BE(^{A}_{Z}X) = [Z M(^{1}_{1}H) + (A-Z) m_n - M(^{A}_{Z}X)] c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(BE(^{A}_{Z}X)\\)",
        "def": "Binding energy of nucleus \\(^{A}_{Z}X\\) [MeV]"
      },
      {
        "sym": "\\(M(^{1}_{1}H)\\)",
        "def": "Mass of hydrogen-1 atom [amu]"
      },
      {
        "sym": "\\(m_n\\)",
        "def": "Mass of neutron [amu]"
      },
      {
        "sym": "\\(M(^{A}_{Z}X)\\)",
        "def": "Mass of element \\(^{A}_{Z}X\\) [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Binding energy computed from mass differences between constituent nucleons and the measured nuclear mass."
      }
    ]
  },
  {
    "id": "prc-15",
    "column": "left",
    "title": "Equation 15: Neutron Separation Energy",
    "equations": [
      "\\[S_n(^{A}_{Z}X) = [M(^{A-1}_{Z}X) + m_n - M(^{A}_{Z}X)] c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(S_n\\)",
        "def": "Neutron separation energy [MeV]"
      },
      {
        "sym": "\\(M(^{A-1}_{Z}X)\\)",
        "def": "Mass of nuclide with one fewer neutron [amu]"
      },
      {
        "sym": "\\(m_n\\)",
        "def": "Mass of neutron [amu]"
      },
      {
        "sym": "\\(M(^{A}_{Z}X)\\)",
        "def": "Mass of original nuclide [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Energy required to remove a neutron from a nucleus — the neutron separation energy. Note: When using this equation for fission calculations, the process is running in reverse (neutron is being injected vs seperated), thus the original nuclide becomes \\(M(^{A-1}_{Z}X)\\)."
      }
    ]
  },
  {
    "id": "prc-16",
    "column": "middle",
    "title": "Equation 16: Proton Separation Energy",
    "equations": [
      "\\[S_p(^{A}_{Z}Y) = [M(^{A-1}_{Z-1}X) + M(^{1}_{1}H) - M(^{A}_{Z}Y)] c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(S_p\\)",
        "def": "Proton separation energy [MeV]"
      },
      {
        "sym": "\\(M(^{A}_{Z}Y)\\)",
        "def": "Mass of original nuclide [amu]"
      },
      {
        "sym": "\\(M(^{1}_{1}H)\\)",
        "def": "Mass of hydrogen-1 [amu]"
      },
      {
        "sym": "\\(M(^{A-1}_{Z-1}X)\\)",
        "def": "Mass of nuclide with one fewer proton [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Energy required to remove a proton from a nucleus — the proton separation energy."
      }
    ]
  },
  {
    "id": "prc-17",
    "column": "left",
    "title": "Equation 17: Q-value from Masses",
    "equations": [
      "\\[Q = \\left[\\sum m_{0,i} - \\sum m_{0,f} \\right] c^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(Q\\)",
        "def": "Q-value, energy of reaction [MeV]"
      },
      {
        "sym": "\\(\\sum m_{0,i}\\)",
        "def": "Sum of initial rest masses [amu]"
      },
      {
        "sym": "\\(\\sum m_{0,f}\\)",
        "def": "Sum of final rest masses [amu]"
      },
      {
        "sym": "\\(c^2\\)",
        "def": "Mass-energy equivalence factor, 931.494013 [MeV/amu]"
      }
    ],
    "description": [
      {
        "p": "Energy released (Q-value) of a nuclear reaction computed from the difference in rest masses."
      }
    ]
  },
  {
    "id": "prc-18",
    "column": "middle",
    "title": "Equation 18: Q-value relation to Kinetic Energy Change",
    "equations": [
      "\\[Q = T_f - T_i\\]"
    ],
    "variables": [
      {
        "sym": "\\(Q\\)",
        "def": "Reaction Q-value, energy released in reaction [MeV]"
      },
      {
        "sym": "\\(T_f\\)",
        "def": "Final kinetic energy [MeV]"
      },
      {
        "sym": "\\(T_i\\)",
        "def": "Initial kinetic energy [MeV]"
      }
    ],
    "description": [
      {
        "p": "Alternate definition of Q-value as the change in total kinetic energy between final and initial states."
      }
    ]
  },
  {
    "id": "prc-19",
    "column": "left",
    "title": "Equation 19: General Two-body Q Relation",
    "equations": [
      "\\[Q = T_1\\left(\\frac{m_1}{m_4}-1\\right)-\\frac{2}{m_4}\\sqrt{m_1 m_3 T_1 T_3}\\cos\\theta + T_3\\left(\\frac{m_3}{m_4}+1\\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(Q\\)",
        "def": "Reaction Q-value [MeV]"
      },
      {
        "sym": "\\(T_1,T_3\\)",
        "def": "Kinetic energies of small particles [MeV]"
      },
      {
        "sym": "\\(m_1,m_3,m_4\\)",
        "def": "Masses of particles [amu]"
      },
      {
        "sym": "\\(\\theta\\)",
        "def": "Scattering angle [&deg;]"
      }
    ],
    "description": [
      {
        "p": "Kinematic relation for Q in a binary reaction including masses, kinetic energies and scattering angle. Implied nomenclature: 1+2 &rarr; 3+4. 1 and 3 are light particles; 2 and 4 are heavy particles. Particle 2 must be stationary."
      }
    ]
  },
  {
