    "variables": [
      {
        "sym": "\\(E_{1}^{th}\\)",
        "def": "Threshold energy for reaction [MeV]"
      },
      {
        "sym": "\\(E_{1}^{K}\\)",
        "def": "Kinematic threshold energy [MeV]"
      },
      {
        "sym": "\\(E_{1}^{C}\\)",
        "def": "Coulombic barrier energy [MeV]"
      }
    ],
    "description": [
      {
        "p": "Reaction threshold energy is the greater of kinematic and Coulomb barrier thresholds. The energy must be supplied by the kinetic energy of the incident particle, 1."
      }
    ]
  },
  {
    "id": "prc-30",
    "column": "middle",
    "title": "Equation 30: Attenuation of Photon Intensity",
    "equations": [
      "\\[I(x) = I_0 e^{-\\mu_t x}\\]"
    ],
    "variables": [
      {
        "sym": "\\(I(x)\\)",
        "def": "Intensity of photons at distance x [1/(cm<sup>2</sup>-s)]"
      },
      {
        "sym": "\\(I_0\\)",
        "def": "Initial photon intensity [1/(cm<sup>2</sup>-s)]"
      },
      {
        "sym": "\\(\\mu_t\\)",
        "def": "Total linear attenuation coefficient [1/cm]"
      },
      {
        "sym": "\\(x\\)",
        "def": "Distance [cm]"
      }
    ],
    "description": [
      {
        "p": "Exponential attenuation of photon beam intensity by a material."
      }
    ]
  },
  {
    "id": "prc-31",
    "column": "right",
    "title": "Equation 31: Neutron Flux Attenuation",
    "equations": [
      "\\[\\phi(x) = \\phi_0 e^{-\\Sigma_t x}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\phi(x)\\)",
        "def": "Neutron flux at position x [1/(cm<sup>2</sup>-s)]"
      },
      {
        "sym": "\\(\\phi_0\\)",
        "def": "Initial neutron flux [1/(cm<sup>2</sup>-s)]"
      },
      {
        "sym": "\\(\\Sigma_t\\)",
        "def": "Total macroscopic cross section [1/cm]"
      },
      {
        "sym": "\\(x\\)",
        "def": "Distance [cm]"
      }
    ],
    "description": [
      {
        "p": "Neutron flux decreases exponentially with distance in a medium."
      }
    ]
  },
  {
    "id": "prc-32",
    "column": "middle",
    "title": "Equation 32: Mean Free Path - Photon",
    "equations": [
      "\\[\\bar{x} = \\frac{1}{\\mu_t}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\bar{x}\\)",
        "def": "Mean free path [cm]"
      },
      {
        "sym": "\\(\\mu_t\\)",
        "def": "Linear attenuation coefficient [1/cm]"
      }
    ],
    "description": [
      {
        "p": "Mean distance a photon travels before an interaction."
      }
    ]
  },
  {
    "id": "prc-33",
    "column": "right",
    "title": "Equation 33: Mean Free Path - Neutron",
    "equations": [
      "\\[\\bar{x} = \\frac{1}{\\Sigma_t}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\bar{x}\\)",
        "def": "Mean free path [cm]"
      },
      {
        "sym": "\\(\\Sigma_t\\)",
        "def": "Total macroscopic cross section [1/cm]"
      }
    ],
    "description": [
      {
        "p": "Mean free path for neutrons in a material."
      }
    ]
  },
  {
    "id": "prc-34",
    "column": "middle",
    "title": "Equation 34: Mass Attenuation to Linear Attenuation Relationship",
    "equations": [
      "\\[\\mu_t = \\left(\\frac{\\mu_t}{\\rho}\\right)\\rho\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu_t\\)",
        "def": "Total linear attenuation coefficient [1/cm]"
      },
      {
        "sym": "\\(\\mu_t/\\rho\\)",
        "def": "Mass attenuation coefficient [cm<sup>2</sup>/g]"
      },
      {
        "sym": "\\(\\rho\\)",
        "def": "Mass density [g/cm<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "Linear attenuation coefficient obtained from mass attenuation coefficient. Useful because mass attenuation coefficients are tabulated while linear attenuation coefficients may not be."
      }
    ]
  },
  {
    "id": "prc-35",
    "column": "right",
    "title": "Equation 35: Macroscopic Cross Section",
    "equations": [
      "\\[\\Sigma_t = \\Sigma_s + \\Sigma_a\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\Sigma_t\\)",
        "def": "Total macroscopic cross section [1/cm]"
      },
      {
        "sym": "\\(\\Sigma_s\\)",
        "def": "Macroscopic scattering cross section[1/cm]"
      },
      {
        "sym": "\\(\\Sigma_a\\)",
        "def": "Macroscopic absorption cross section[1/cm]"
      }
    ],
    "description": [
      {
        "p": "Total macroscopic cross section is the sum of the two possible neutron interactions: scattering and absorption."
      }
    ]
  },
  {
    "id": "prc-36",
    "column": "middle",
    "title": "Equation 36: Mass Attenuation Coefficient Composition",
    "equations": [
      "\\[\\left(\\frac{\\mu_t}{\\rho}\\right)=\\sum_i \\left(\\frac{\\mu_i}{\\rho}\\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu_t/\\rho\\)",
        "def": "Total mass attenuation coefficient [cm<sup>2</sup>/g]"
      },
      {
        "sym": "\\(\\mu_i/\\rho\\)",
        "def": "Mass attenuation for each photon interaction type, i [cm<sup>2</sup>/g]"
      }
    ],
    "description": [
      {
        "p": "Mass attenuation coefficient is the sum of mass attenuation coefficient from each photon interaction type."
      }
    ]
  },
  {
    "id": "prc-37",
    "column": "right",
    "title": "Equation 37: Macroscopic Cross Section Definition",
    "equations": [
      "\\[\\Sigma_i = N \\sigma_i(E) g_i(T)\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\Sigma_i\\)",
        "def": "Macroscopic cross section for interaction i [1/cm]"
      },
      {
        "sym": "\\(N\\)",
        "def": "Number density of particular nuclide [1/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\sigma_i(E)\\)",
        "def": "Microscopic cross section of interaction type i at energy E [cm<sup>2</sup>]"
      },
      {
        "sym": "\\(g_i(T)\\)",
        "def": "Westcott factor - Correction factor for temperature of target nuclide [-]"
      }
    ],
    "description": [
      {
        "p": "Macroscopic cross section equals number density times microscopic cross section. Microscopic cross sections are tabulated in barns and are dependent on the incident neutron energy."
      }
    ]
  },
  {
    "id": "prc-38",
    "column": "middle",
    "title": "Equation 38: Mass Attenuation for Mixtures (weighted)",
    "equations": [
      "\\[\\left(\\frac{\\mu_i}{\\rho}\\right)=\\sum_j w_j \\left(\\frac{\\mu_i}{\\rho}\\right)^j\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu_i/\\rho\\)",
        "def": "Mass attenuation coefficient for interaction i [cm<sup>2</sup>/g]"
      },
      {
        "sym": "\\(w_j\\)",
        "def": "Weight fraction of component j [-]"
      },
      {
        "sym": "\\((\\mu_i/\\rho)_j\\)",
        "def": "Mass attenuation coefficient of interaction i for component j [cm<sup>2</sup>/g]"
      }
    ],
    "description": [
      {
        "p": "Composite mass attenuation coefficient formed from weight-fraction-weighted component contributions."
      }
    ]
  },
  {
    "id": "prc-39",
    "column": "right",
    "title": "Equation 39: Point Source Flux with Attenuation",
    "equations": [
      "\\[\\phi(r) = \\frac{S_p}{4\\pi r^2} e^{-\\Sigma_t x}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\phi(r)\\)",
        "def": "Flux at distance r [1/(cm<sup>2</sup>-s)]"
      },
      {
        "sym": "\\(S_p\\)",
        "def": "Source strength [particles/s]"
      },
      {
        "sym": "\\(r\\)",
        "def": "Distance [cm]"
      },
      {
        "sym": "\\(\\Sigma_t\\)",
        "def": "Total macroscopic cross section, for neutrons [1/cm]"
      },
      {
        "sym": "\\(\\mu_t\\)",
        "def": "Linear attenuation coefficient, used in place of \\(\\Sigma_t\\) for photons [1/cm]"
      },
      {
        "sym": "\\(x\\)",
        "def": "Shield or medium thickness [cm]"
      }
    ],
    "description": [
      {
        "p": "This equation works for both neutrons and photons as geometric and exponential attenuation operate in the same way. Flux from a point source decreases with inverse square law and exponential attenuation in the medium. Applicable for photons but with &mu; instead of &Sigma;"
      }
    ]
  },
  {
    "id": "prc-40",
    "column": "left",
    "title": "Equation 40: Scattering Energy Transfer (lab frame)",
    "equations": [
      "\\[E' = \\frac{1}{(A+1)^2}\\Bigl(\\sqrt{E}\\cos\\theta_s + \\sqrt{E(A^2-1+\\cos^2\\theta_s)}\\Bigr)^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(E&#x27;\\)",
        "def": "= Kinetic energy of scattered neutron [eV or MeV]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Initial kinetic energy of neutron [eV or MeV]"
      },
      {
        "sym": "\\(A\\)",
        "def": "Target atomic mass number [-]"
      },
      {
        "sym": "\\(\\theta_s\\)",
        "def": "Scattering angle [&deg;]"
      }
    ],
    "description": [
      {
        "p": "Energy of a scattered neutron after collision with a nucleus; derived from two-body kinematics."
      }
    ]
  },
  {
    "id": "prc-41",
    "column": "left",
    "title": "Equation 41: Average Scattered Energy",
    "equations": [
      "\\[E'_{av} = \\frac{1}{2} (E + \\alpha E)\\]"
    ],
    "variables": [
      {
        "sym": "\\(E&#x27;_{av}\\)",
        "def": "Average scattered neutron kinetic energy [eV or MeV]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Initial neutron kinetic energy [eV or MeV]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Collision parameter [-]"
      }
    ],
    "description": [
      {
        "p": "Average scattered energy from elastic neutron scattering reaction."
      }
    ]
  },
  {
    "id": "prc-42",
    "column": "middle",
    "title": "Equation 42: Minimum Scattered Energy",
    "equations": [
      "\\[E'_{min} = \\alpha E\\]"
    ],
    "variables": [
      {
        "sym": "\\(E&#x27;_{min}\\)",
        "def": "Minimum scattered neutron kinetic energy [eV or MeV]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Collision parameter [-]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Initial neutron kinetic energy [eV or MeV]"
      }
    ],
    "description": [
      {
        "p": "Minimum resulting kinetic energy of neutron following an elastic scattering event."
      }
    ]
  },
  {
    "id": "prc-43",
    "column": "middle",
    "title": "Equation 43: Collision Factor Definition",
    "equations": [
      "\\[\\alpha = \\left(\\frac{A-1}{A+1}\\right)^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\alpha\\)",
        "def": "Collision parameter [-]"
      },
      {
        "sym": "\\(A\\)",
        "def": "Target atomic mass number [-]"
      }
    ],
    "description": [
      {
        "p": "Collision parameter definition. Maximum fractional energy loss resulting from elastic collision with an incident fast-moving neutron."
      }
    ]
  },
  {
    "id": "prc-44",
    "column": "left",
    "title": "Equation 44: Logarithmic Energy Decrement Definition",
    "equations": [
      "\\[\\xi = 1 + \\frac{\\alpha}{1-\\alpha}\\ln\\alpha\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\xi\\)",
        "def": "Average logarithmic energy decrement [-]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Collision parameter [-]"
      }
    ],
    "description": [
      {
        "p": "Average logarithmic energy decrement per collision used in slowing-down theory for neutrons. Also referred to as average lethargy loss."
      }
    ]
  },
  {
    "id": "prc-45",
    "column": "middle",
    "title": "Equation 45: Number of Collisions for Energy Change",
    "equations": [
      "\\[n = \\frac{1}{\\xi}\\ln\\frac{E_1}{E_2}\\]"
    ],
    "variables": [
      {
        "sym": "\\(n\\)",
        "def": "Average number of collisions [-]"
      },
      {
        "sym": "\\(\\xi\\)",
        "def": "Logarithmic energy loss per collision [-]"
      },
      {
        "sym": "\\(E_1,E_2\\)",
        "def": "Initial and final neutron kinetic energies [eV or MeV]"
      }
    ],
    "description": [
      {
        "p": "Number of collisions required to slow a particle from energy E<sub>1</sub> to E<sub>2</sub> for a target nuclide."
      }
    ]
  },
  {
    "id": "prc-46",
    "column": "left",
    "title": "Equation 46: Reaction Rate \\(R_i\\)",
    "equations": [
      "\\[R_i = \\Sigma_i \\phi(E)\\]"
    ],
    "variables": [
      {
        "sym": "\\(R_i\\)",
        "def": "Reaction rate density for interaction i [reactions/(cm<sup>3</sup>-s)]"
      },
      {
        "sym": "\\(\\Sigma_i\\)",
        "def": "Macroscopic cross section for interaction i [1/cm]"
      },
      {
        "sym": "\\(\\phi(E)\\)",
        "def": "Neutron flux at energy E [1/(cm<sup>2</sup>-s)]"
      }
    ],
    "description": [
      {
        "p": "Reaction rate per unit volume obtained by multiplying macroscopic cross section by particle flux."
      }
    ]
  },
  {
    "id": "prc-47",
    "column": "left",
    "title": "Equation 47: Six-Factor Formula for Criticality",
    "equations": [
      "\\[k_{eff} = \\varepsilon\\,p\\,f\\,\\eta\\,P_{NL}^{f}\\,P_{NL}^{th}\\]"
    ],
    "variables": [
      {
        "sym": "\\(k_{eff}\\)",
        "def": "Effective multiplication factor [-]"
      },
      {
        "sym": "\\(\\varepsilon\\)",
        "def": "Fast fission factor [-]"
      },
      {
        "sym": "\\(p\\)",
        "def": "Resonance escape probability [-]"
      },
      {
        "sym": "\\(f\\)",
        "def": "Thermal utilization factor [-]"
      },
      {
        "sym": "\\(\\eta\\)",
        "def": "Thermal reproduction factor, or thermal fission factor [-]"
      },
      {
        "sym": "\\(P_{NL}^{f},P_{NL}^{th}\\)",
        "def": "Non-leakage probabilities for fast and thermal neutrons [-]"
      }
    ],
    "description": [
      {
        "p": "Six-factor formula for calculating the criticality of a nuclear reactor. Must be a thermal reactor where neutrons are slowed down to the thermal spectrum."
      }
    ]
  },
  {
    "id": "prc-48",
    "column": "left",
    "title": "Equation 48: Infinite Multiplication Factor \\(k_{\\infty}\\)",
    "equations": [
      "\\[k_{\\infty} = \\varepsilon\\,p\\,f\\,\\eta\\]"
    ],
    "variables": [
      {
        "sym": "\\(k_{\\infty}\\)",
        "def": "Infinite multiplication factor [-]"
      },
      {
        "sym": "\\(\\varepsilon\\)",
        "def": "Fast fission factor [-]"
      },
      {
        "sym": "\\(p\\)",
        "def": "Resonance escape probability [-]"
      },
      {
        "sym": "\\(f\\)",
        "def": "Thermal utilization factor [-]"
      },
      {
        "sym": "\\(\\eta\\)",
        "def": "Thermal reproduction factor, or thermal fission factor [-]"
      }
    ],
    "description": [
      {
        "p": "Four-factor formula for expressing the infinite multiplication factor of a reactor. That is, the multiplication factor if the reactor were infinitely large."
      }
    ]
  },
  {
    "id": "prc-49",
    "column": "left",
    "title": "Equation 49: Fast Non-leakage Probability \\(P_{NL}^{f}\\)",
    "equations": [
      "\\[P_{NL}^{f} = e^{-B_C^2 \\tau _T}\\]"
    ],
    "variables": [
      {
        "sym": "\\(P_{NL}^{f}\\)",
        "def": "Fast non-leakage probability [-]"
      },
      {
        "sym": "\\(B_C\\)",
        "def": "Core buckling [1/cm]"
      },
      {
        "sym": "\\(\\tau _T\\)",
        "def": "Fermi age, material property [cm<sup>2</sup>]"
      }
    ],
    "description": [
      {
        "p": "Approximate form expressing the probability that fast neutrons do not leak from the core; depends on geometry and material properties."
      }
    ]
  },
  {
    "id": "prc-50",
    "column": "left",
    "title": "Equation 50: Thermal Non-Leakage Probability \\(P_{NL}^{th}\\)",
    "equations": [
      "\\[P_{NL}^{th} = \\frac{1}{1 + L_T^2 B_C^2}\\]"
    ],
    "variables": [
      {
        "sym": "\\(P_{NL}^{th}\\)",
        "def": "Thermal non-leakage probability [-]"
      },
      {
        "sym": "\\(L_T\\)",
        "def": "Thermal diffusion length, material property [cm]"
      },
      {
        "sym": "\\(B_C\\)",
        "def": "Core buckling [1/cm]"
      }
    ],
    "description": [
      {
        "p": "Thermal non-leakage probability in diffusion approximation; dependent on geometry and material properties."
      }
    ]
  },
  {
    "id": "prc-51",
    "column": "middle",
    "title": "Equation 51: Thermal Utilization Factor f",
    "equations": [
      "\\[f = \\frac{\\Sigma_a^F}{\\Sigma_a^F + \\Sigma_a^{NF}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(f\\)",
        "def": "Thermal utilization factor [-]"
      },
      {
        "sym": "\\(\\Sigma_a^F\\)",
        "def": "Fuel macroscopic absorption cross section [1/cm]"
      },
      {
        "sym": "\\(\\Sigma_a^{NF}\\)",
        "def": "Non-fuel macroscopic absorption cross section [1/cm]"
      }
    ],
    "description": [
      {
        "p": "Fraction of thermal neutrons absorbed in the fuel."
      }
    ]
  },
  {
    "id": "prc-52",
    "column": "right",
    "title": "Equation 52: Thermal Reproduction Factor η",
    "equations": [
      "\\[\\eta = \\nu \\frac{\\Sigma_f^F}{\\Sigma_a^F}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\eta\\)",
        "def": "Thermal reproduction factor, or thermal fission factor [-]"
      },
      {
        "sym": "\\(\\nu\\)",
        "def": "Average neutrons per fission [-]"
      },
      {
        "sym": "\\(\\Sigma_f^F\\)",
        "def": "Macroscopic fission cross section for fuel [1/cm]"
      },
      {
        "sym": "\\(\\Sigma_a^F\\)",
        "def": "Macroscopic absorption cross section for fuel [1/cm]"
      }
    ],
    "description": [
      {
        "p": "Average number of neutrons produced per neutron absorbed in the fuel."
      }
    ]
  }
]
